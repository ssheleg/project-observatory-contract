{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ssheleg/project-observatory-contract/rev-3/schemas/capability-output.schema.json",
  "title": "estate.survey — output",
  "type": "object",
  "additionalProperties": false,
  "required": ["surveyedAt", "scanId", "scope", "counts", "projects", "evidence", "degraded"],
  "properties": {
    "surveyedAt": { "type": "string", "format": "date-time" },
    "scanId": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "repositories", "owners"],
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "repositories": { "type": "integer", "minimum": 0 },
        "owners": { "type": "integer", "minimum": 0 }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "ownership", "lifecycle", "repositories", "membershipRules"],
        "properties": {
          "id": { "type": "string", "pattern": "^project:" },
          "name": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["owned", "work-bitbucket", "external", "local-only"] },
          "lifecycle": { "enum": ["active", "archived"] },
          "description": { "type": "string" },
          "descriptionSource": { "type": "string" },
          "localFolders": { "type": "array", "items": { "type": "string" } },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "host", "nameWithOwner"],
              "properties": {
                "id": { "type": "string", "pattern": "^repository:" },
                "host": { "enum": ["github", "bitbucket"] },
                "nameWithOwner": { "type": "string" },
                "visibility": { "enum": ["public", "private", "internal", "unknown"] },
                "defaultBranch": { "type": "string" },
                "archived": { "type": "boolean" },
                "fork": { "type": "boolean" },
                "lastPushedOn": { "type": "string" },
                "discoveredBy": { "enum": ["github-api", "local-remote-only"] }
              }
            }
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "confidence", "evidence"],
              "properties": {
                "host": { "type": "string" },
                "ownedDomain": { "type": ["string", "null"] },
                "confidence": { "enum": ["registry-confirmed", "declared-not-in-registry"] },
                "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          },
          "stack": { "type": "array", "items": { "type": "string" } },
          "lastActivityOn": { "type": "string" },
          "hasVaultNote": { "type": "boolean" },
          "membershipRules": {
            "type": "array",
            "description": "One entry per repository, naming the rule that justified the link. An empty array is only valid for a project with no repositories.",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Resolvable references for the survey itself: the source ids in the registry that produced it."
    },
    "degraded": {
      "type": "array",
      "description": "Sources that could not be read this run. An empty array asserts full coverage; it is never omitted.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
